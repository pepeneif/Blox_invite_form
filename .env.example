# Blox_invite_form — configuracion (copia este fichero a .env y ajusta)

# --- Servidor web (la pagina del formulario) ---
# 127.0.0.1 solo escucha en local (recomendado si pones Caddy/nginx delante).
# Usa 0.0.0.0 para que sea accesible desde fuera sin proxy.
FORM_HOST=127.0.0.1
FORM_PORT=8090

# --- SMTP (a donde se manda el correo) ---
# plain    = sin cifrar (relay local en 127.0.0.1:25, Postfix/msmtp/sendmail)
# starttls = 587 o 25, sube a TLS con STARTTLS (Gmail, SES, Mailgun, etc.)
# tls      = 465, TLS directo desde el principio
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURITY=plain

# Usuario y contrasena SMTP. Vacio en un relay local.
SMTP_USER=
SMTP_PASS=

# Nombre que el servidor se da al saludar (EHLO).
SMTP_HELO=bloxcross.com

# --- Correo ---
# Remitente tecnico (sobre). Normalmente igual que el From visible.
MAIL_FROM=bot@bloxcross.com
# Cabecera From visible en el cliente de correo.
FROM_HEADER=Bot <bot@bloxcross.com>
# DESTINO: aqui llegan los contactos del formulario.
MAIL_TO=admin@bloxcross.com
# Prefijo del asunto.
MAIL_SUBJECT_PREFIX=Blox.Global — contacts

# --- Limites ---
MAX_ROWS=200
MAX_BODY_BYTES=131072
SMTP_TIMEOUT_MS=15000
